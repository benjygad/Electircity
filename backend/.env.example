# SEMS backend configuration — copy to .env and fill in.
# NEVER commit real credentials. This file is loaded by backend/src/Core/Env.php.

# APP_ENV=development | production
APP_ENV=development
APP_DEBUG=1
# Timezone used for display helpers (storage is always UTC)
APP_TIMEZONE=Africa/Dar_es_Salaam

# CORS: exact origin allowed for the admin dashboard (comma-separated list allowed).
# Use * only for local development.
CORS_ALLOWED_ORIGIN=*

# Database: mysql (primary) or sqlite (portability/tests)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sems
DB_USER=sems_app
DB_PASS=CHANGE_ME

# Only used when DB_DRIVER=sqlite
DB_SQLITE_PATH=../storage/sems.sqlite

# Bearer token lifetime (hours)
TOKEN_TTL_HOURS=72

# Rate limiting for auth endpoints: max attempts per window
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_SECONDS=300
